APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
MAIL_ALWAYS_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=YOUR_API_KEY_HERE

# Facturación Electrónica DIAN
DIAN_BILLING_PROVIDER=sandbox
DIAN_ENVIRONMENT=sandbox
DIAN_QR_BASE_URL="https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey="
FACTUS_SANDBOX_URL="https://api-sandbox.factus.co"
FACTUS_PROD_URL="https://api.factus.co"
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=

# Pasarela de Pagos Wompi Colombia (https://docs.wompi.co)
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...
WOMPI_EVENT_SECRET=test_events_...
WOMPI_SANDBOX=true
WOMPI_CURRENCY=COP
WOMPI_WEBHOOK_URL=https://tudominio.com/api/payments/wompi/webhook

# Liquidación Marketplace & Envíos Multivendedor
MARKETPLACE_PLATFORM_FEE_PERCENT=5.0
MARKETPLACE_SHIPPING_COST_PER_VENDOR=6000
MARKETPLACE_FREE_SHIPPING_THRESHOLD=120000

# Pasarela de Pagos Mercado Pago México (https://www.mercadopago.com.mx/developers/es/docs)
MERCADOPAGO_MX_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_MX_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_MX_WEBHOOK_SECRET=
MERCADOPAGO_CO_PUBLIC_KEY=
MERCADOPAGO_CO_ACCESS_TOKEN=
MERCADOPAGO_CO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_WEBHOOK_URL=https://tudominio.com/api/payments/mercadopago/webhook


